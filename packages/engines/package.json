{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@reasonsmith/engines",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Reasonsmith engines: the observed (temporal record), probed (perturb-and-replay), proved (rule logic) and certificate (artifact reason-fidelity) rungs.",
  "scripts": {
