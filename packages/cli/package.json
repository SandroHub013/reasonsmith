{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@reasonsmith/cli",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Reasonsmith command-line entry point: run a conformance check over a system against an Evidence pack and render the report.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test src/**/*.test.ts",
    "run": "bun ./src/index.ts"
  },
  "bin": {
    "reasonsmith-ts": "./src/index.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@reasonsmith/core": "workspace:*",
    "@reasonsmith/engines": "workspace:*",
    "@reasonsmith/systems": "workspace:*",
    "@effect/platform-bun": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@tsconfig/bun": "catalog:",
    "@types/bun": "1.3.7",
    "typescript": "catalog:"
  }
}